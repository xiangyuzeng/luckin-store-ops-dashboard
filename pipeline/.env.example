# Copy to pipeline/.env and fill in real values. .env is gitignored.
# Required by the in-container scheduler (pipeline/scheduler/cron_runner.py).

# ── MySQL credentials ──────────────────────────────────────────────
# Pick ONE of the two paths below.

# Path A (default): AWS Secrets Manager
AWS_REGION=us-east-1
MYSQL_SECRET_NAME=collector/mysql
# Optional: if running on a host without an IAM role, set these too.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Path B (direct): uncomment if Secrets Manager isn't reachable.
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=luckyus_iluckyhealth

# ── Per-database RDS hosts (optional overrides) ────────────────────
# Each service has its own RDS instance in production; the username/password
# from the secret above are shared across all of them, but the host isn't.
# Defaults use the internal alias `aws-luckyus-{service}-rw`. Override here
# only if your VPC's DNS uses different names.
# OPSHOP_HOST=
# SALESORDER_HOST=
# SCM_SHOPSTOCK_HOST=
# ILUCKYHEALTH_HOST=

# ── GitHub push ────────────────────────────────────────────────────
# Token needs `contents:write` on the target repo only — no other scopes.
GITHUB_TOKEN=
GITHUB_REPO=xiangyuzeng/luckin-store-ops-dashboard
GITHUB_BRANCH=main
GITHUB_FILE_PATH=data/payload.json

# ── Pipeline tuning ────────────────────────────────────────────────
LUCKIN_TENANT=LKUS
RETAIN_DAYS=90
HALF_HOUR_RETAIN_DAYS=3
LOG_DIR=/workspace/logs
