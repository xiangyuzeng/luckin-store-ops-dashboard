# Copy to pipeline/.env and fill in real values. .env is gitignored.
# Required by the in-container scheduler (pipeline/scheduler/cron_runner.py).

# ── MySQL credentials ──────────────────────────────────────────────
# Pick ONE of the two paths below.

# Path A (default): AWS Secrets Manager
AWS_REGION=us-east-1
MYSQL_SECRET_NAME=collector/mysql
# Optional: if running on a host without an IAM role, set these too.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Path B (direct): uncomment if Secrets Manager isn't reachable.
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=luckyus_iluckyhealth

# ── Per-database RDS endpoints ─────────────────────────────────────
# Each service has its own RDS instance in production; the username/password
# from the secret above are shared across all of them, but the host isn't.
# By default the resolver reads pipeline/config/rds_instances.json (db →
# instance ID) and calls rds:DescribeDBInstances to fetch the FQDN at
# startup, then caches per process.
#
# IAM permission required (in addition to secretsmanager:GetSecretValue):
#   rds:DescribeDBInstances on the eight target instances.
#
# Set these only if you want to pin a specific endpoint or your network
# can't reach the RDS API — they short-circuit the boto3 lookup.
# OPSHOP_HOST=
# SALESORDER_HOST=
# SCM_SHOPSTOCK_HOST=
# ILUCKYHEALTH_HOST=
# OPEMPEFFICIENCY_HOST=
# OPQUALITYCONTROL_HOST=
# SCM_COMMODITY_HOST=
# SCM_PURCHASE_HOST=

# ── GitHub push ────────────────────────────────────────────────────
# Token needs `contents:write` on the target repo only — no other scopes.
GITHUB_TOKEN=
GITHUB_REPO=xiangyuzeng/luckin-store-ops-dashboard
GITHUB_BRANCH=main
GITHUB_FILE_PATH=data/payload.json

# ── Pipeline tuning ────────────────────────────────────────────────
LUCKIN_TENANT=LKUS
RETAIN_DAYS=90
HALF_HOUR_RETAIN_DAYS=3
LOG_DIR=/workspace/logs

# ── Daily cron schedule ────────────────────────────────────────────
# When to run the daily refresh. Defaults to 01:00 US/Eastern (off-peak
# both for MySQL load and for operator dashboards).
#   DAILY_TIMEZONE  IANA zone (US/Eastern, Asia/Shanghai, UTC, …)
#   DAILY_HOUR      0-23
#   DAILY_MINUTE    0-59
DAILY_TIMEZONE=US/Eastern
DAILY_HOUR=1
DAILY_MINUTE=0

# ── hourlyCupAchieve target ────────────────────────────────────────
# Theoretical equivalent-cups-per-hour benchmark, used as the denominator
# for hourlyCupAchieve = perfHourlyCups / THEORETICAL_HOURLY_CUPS.
# 30 is the initial placeholder; China HQ may publish per-tier values
# later — replace this with a config table read at that point.
THEORETICAL_HOURLY_CUPS=30
